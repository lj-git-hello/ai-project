# ===== 对话模型：火山引擎 Coding Plan（OpenAI 兼容协议） =====
# base URL 用 coding plan 专属地址，模型名直接填（不走接入点 ep-）
# 可选模型：glm-5.3 / doubao-seed-2.0-lite / kimi-k2.7-code / deepseek-v4-pro 等
LLM_API_KEY=ark-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
CHAT_MODEL=glm-5.3

# ===== Embedding 模型：火山引擎方舟（与对话模型同一 Coding 端点/Key） =====
EMBEDDING_API_KEY=ark-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
EMBEDDING_MODEL=doubao-embedding-vision
EMBEDDING_DIMENSIONS=1024

# ===== 服务配置 =====
PORT=3000
# 生产环境设为 production（关闭调试写盘等）
NODE_ENV=development
