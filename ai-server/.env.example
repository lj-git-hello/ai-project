# ===== 对话模型：火山引擎 Coding Plan（OpenAI 兼容协议） =====
# base URL 用 coding plan 专属地址，模型名直接填（不走接入点 ep-）
# 可选模型：glm-5.2 / doubao-seed-2.0-lite / kimi-k2.7-code / deepseek-v4-pro 等
LLM_API_KEY=ark-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
CHAT_MODEL=glm-5.2

# ===== Embedding 模型：阿里云百炼 DashScope（不变） =====
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_BASE_URL=https://ws-lni3s5bm8fy9o869.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1024

# ===== 服务配置 =====
PORT=3000
# 生产环境设为 production（关闭调试写盘等）
NODE_ENV=development
