# ===== 对话模型：火山引擎方舟（OpenAI 兼容协议） =====
# 在方舟控制台创建「接入点」后，填入 API Key 和接入点 ID
LLM_API_KEY=ark-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
CHAT_MODEL=ep-2026xxxxxxxx-xxxxx

# ===== Embedding 模型：阿里云百炼 DashScope（不变） =====
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_BASE_URL=https://ws-lni3s5bm8fy9o869.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1024

# ===== 服务配置 =====
PORT=3000
# 生产环境设为 production（关闭调试写盘等）
NODE_ENV=development
